TELEGRAM_BOT_TOKEN=123456:replace-with-botfather-token

# РФ без ключа: OpenAI-совместимый endpoint Pollinations.
LLM_PROVIDER=pollinations
LLM_API_KEY=pollinations
LLM_TIMEOUT_S=90

# OpenRouter, бесплатные модели (:free), карта не нужна.
# Ключ: https://openrouter.ai/keys
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-v1-replace-me

# Локально, без облака: установить Ollama, затем ollama pull qwen2.5
# LLM_PROVIDER=ollama
# LLM_API_KEY=ollama

# Gemini (часто блокирует РФ): https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# LLM_API_KEY=...

# Groq: https://console.groq.com/keys
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_...
